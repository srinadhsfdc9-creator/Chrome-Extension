{
  "manifest_version": 3,
  "name": "Interview Copilot",
  "version": "1.0",
  "description": "An invisible assistant that reads questions from screen/webpages and provides instant solutions.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.live.com/*",
        "https://teams.microsoft.com/*",
        "https://*.zoom.us/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Interview Copilot"
  }
}
